{
  "name": "gerrit-hero",
  "version": "0.1.0",
  "description": "Browser extension that enhances Gerrit Code Review UX",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-build-id.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-build-id.mjs",
    "build": "vite build",
    "pack": "npm run build && cd dist && zip -r ../gerrit-hero.zip .",
    "build:site": "node scripts/build-site.mjs",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.268",
    "eslint": "^9.17.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
